{
  "name": "lighthouse",
  "version": "0.1.0",
  "productName": "Lighthouse Lodge",
  "description": "Offline-first Lighthouse Lodge operations, booking, inventory, and point-of-sale system.",
  "author": "Lighthouse Lodge",
  "private": true,
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "build": "next build --webpack",
    "start": "next start",
    "desktop:prepare": "npm run build && node scripts/prepare-next-standalone.mjs",
    "desktop:stage": "node scripts/prepare-desktop-package.mjs",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:run": "npm run desktop:prepare && electron .",
    "desktop:dir": "npm run desktop:prepare && npm run desktop:stage && electron-builder --projectDir .desktop-package --win --dir --publish never",
    "desktop:pack": "npm run desktop:prepare && npm run desktop:stage && electron-builder --projectDir .desktop-package --win nsis --publish never",
    "desktop:publish": "npm run desktop:prepare && npm run desktop:stage && electron-builder --projectDir .desktop-package --win nsis --publish always",
    "firebase:create-user": "node scripts/manage-staff-user.mjs",
    "firebase:verify-auth": "node scripts/verify-firebase-auth.mjs",
    "firebase:verify-client": "node scripts/verify-client-sync.mjs",
    "firebase:verify-database": "node scripts/verify-realtime-database.mjs",
    "firebase:verify": "node scripts/verify-firebase-admin.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^4.1.3",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dotenv": "^16.5.0",
    "electron-updater": "^6.8.9",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^11.9.1",
    "firebase-admin": "^13.4.0",
    "idb": "^7.1.1",
    "lucide-react": "^0.475.0",
    "next": "^16.3.3",
    "patch-package": "^8.0.0",
    "react": "^19.2.1",
    "react-day-picker": "^9.11.3",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "19.2.1",
    "@types/react-dom": "19.2.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.24",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "uuid": "11.1.1",
    "@firebase/app": "0.13.2"
  },
  "build": {
    "appId": "tz.co.lighthouse.lodge",
    "productName": "Lighthouse Lodge",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "server"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Lighthouse-Lodge-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lighthouse Lodge",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Sun-Chucho",
        "repo": "lighthouse",
        "releaseType": "release"
      }
    ]
  }
}
